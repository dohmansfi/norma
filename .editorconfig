root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break; leave them alone.
trim_trailing_whitespace = false

[*.{json,toml,yaml,yml}]
indent_size = 2

[*.csv]
insert_final_newline = true
